{
  // https://github.com/ioBroker/ioBroker.javascript/blob/d6396dd33754152994585e982c68c8432cba96c1/lib/typescriptSettings.js#L9
  "compilerOptions": {
    "noEmitOnError": true,
    "declaration": true,
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,
    "target": "es2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022"],
    "module": "es2022",
    "ignoreDeprecations": "6.0",

    "sourceMap": false,
    "outDir": "dist",
    "types": ["node", "@iobroker/types"]
  }
}
