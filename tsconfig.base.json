{
  // https://github.com/ioBroker/ioBroker.javascript/blob/bb0d2be8ca51c2132fd34cc3c10fecd141aabb3c/src/lib/typescriptSettings.ts#L21
  "compilerOptions": {
    // Different from default settings, I want type safety.
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,

    // Cannot use commonjs from defaults, otherwise top-level await does not
    // compile without transformation performed by adapter.
    "module": "es2022",
    "target": "es2022",
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],

    "sourceMap": false,
    "outDir": "dist",
    "types": ["node", "@iobroker/types"]
  }
}
